# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth
# In production this must be a long random string (32+ chars) and
# ADMIN_PASSWORD must NOT be the default below — the server will refuse to
# start otherwise. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@veritasprep.com
ADMIN_PASSWORD=changeme123

# Database (LowDB — still active; Supabase migration happens in a later step)
# DB_PATH=./veritas.json

# Supabase (added Step 3 — not yet wired into the app)
# Find these in Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Email (Resend — https://resend.com)
# Leave RESEND_API_KEY unset during local dev: emails will be logged to the
# console instead of sent, so nothing breaks while you're testing.
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=Veritas Prep <feedback@yourdomain.com>

