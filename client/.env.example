# Vite only exposes variables prefixed with VITE_ to browser code.
# Copy this file to client/.env and fill in your values.

# Supabase — Project Settings → API
# The anon key is safe to expose in the browser (it's rate-limited and
# constrained by Row Level Security). Never put the service role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Used to build email verification / password reset redirect links.
# Leave unset locally — it defaults to window.location.origin (localhost:5173).
# VITE_SITE_URL=https://veritasprep.us
